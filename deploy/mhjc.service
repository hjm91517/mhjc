[Unit]
Description=mhjc Web Service
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/mhjc
Environment="PATH=/var/www/mhjc/venv/bin"
Environment="MHJC_HOST=127.0.0.1"
Environment="MHJC_PORT=5000"
ExecStart=/var/www/mhjc/venv/bin/gunicorn \
    --workers 2 \
    --threads 4 \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    --capture-output \
    server:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
